{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Train-Alice",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "args": ["--config", "${workspaceFolder}/configs/gpt2_133m_config.yaml", "--data", "alice"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Train-Wikipedia-133M",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "args": ["--config", "${workspaceFolder}/configs/gpt2_133m_config.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Train-Wikipedia-162M",
            "type": "debugpy",
            "request": "launch",
            "program": "train.py",
            "args": ["--config", "${workspaceFolder}/configs/gpt2_162m_config.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Generate",
            "type": "debugpy",
            "request": "launch",
            "program": "generate.py",
            "args": ["--checkpoint", "${input:checkpoint}", "--config", "${workspaceFolder}/configs/gpt2_133m_config.yaml"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal"
        }
    ],
    "inputs": [
        {
            "id": "checkpoint",
            "type": "promptString",
            "description": "Path to a checkpoint, e.g. outputs/<run>/best.pt"
        }
    ]
}
